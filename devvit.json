{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "adu-layangan",
  "permissions": {
    "redis": true,
    "journeys": true
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Post today's sky",
        "description": "Creates the post for today's Adu Layangan sky",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onAppUpgrade": "/internal/triggers/on-app-upgrade"
  },
  "scheduler": {
    "tasks": {
      "daily-post": {
        "endpoint": "/internal/cron/daily-post",
        "cron": "0 0 * * *"
      }
    }
  },
  "dev": {
    "subreddit": "adu_layangan_dev"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  }
}
